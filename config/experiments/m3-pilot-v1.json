  "experiment_id": "m3-pilot-v1",
  "financial_notice": "The gateway budget is a SOFT limit, not a guaranteed maximum liability. Usage is known only after a response is metered; an interrupted request is charged at an upper bound (input as reported plus max_tokens output, about $0.64 of output alone at max_tokens 64000) that can exceed the budget by itself; a request killed before it is metered may be billed and never recorded. The pilot allows one concurrent request per agent and stops on incomplete accounting.",
  "kind": "feasibility_pilot",
  "limits": {
    "b_max_test_fix_cycles": 5,
    "budget_usd_per_run": null,
    "calibration_note": "budgets are fixed after an approved real-API calibration and the definition is then re-hashed and locked; until then nothing may spend",
    "client_budget_margin": "1.10",
    "disk": {
      "hard_stop_gib": 12,
      "start_gate_gib": 16
    },
    "gateway_max_concurrent": 1,
    "max_total_computed_usd": null,
    "same_for_both_arms": "one limits block: nothing here is keyed by arm",
    "wall_clock_s": 1800
  },
  "metrics": {
    "definitions": {
      "cap_exceeded": "test_fix_cycles > 5",
      "compliance_B": "test_runs >= 1 AND (no failed test run OR at least one test-fix cycle) AND test_fix_cycles <= 5",
      "test_fix_cycle": "a FAILED test run followed, before the next test run, by at least one Edit or Write tool call",
      "test_run": "a Bash tool call whose command matches test_command_patterns",
      "test_usage": "test_runs >= 1 (measured in BOTH arms; in A it is spontaneous)"
    },
    "primary": "issue resolved (harness verdict: all FAIL_TO_PASS pass and all PASS_TO_PASS maintained), per task and arm",
    "secondary": [
      "wall seconds",
      "gateway-computed cost (and uncached-equivalent cost)",
      "tokens by field",
      "requests and request outcomes",
      "turns",
      "test runs",
      "test-fix cycles",
      "compliance"
    ],
    "test_command_patterns": {
      "exclusions": [
        "--version",
        "--help",
        "(^|\\s)-h(\\s|$)",
        "--collect-only",
        "--co(\\s|$)"
      ],
      "note": "a Bash command counts as a TEST RUN when it matches any of these (case-sensitive) regular expressions and none of the exclusions",
      "runners": [
        "(^|[\\s;&|(])(python[0-9.]*\\s+-m\\s+pytest|py\\.test|pytest|tox|nosetests)(\\s|$)",
        "(^|[\\s;&|(])python[0-9.]*\\s+-m\\s+unittest(\\s|$)",
        "(^|[\\s;&|(])python[0-9.]*\\s+(\\S*/)?runtests\\.py(\\s|$)",
        "(^|[\\s;&|(])(\\S*/)?bin/test(\\s|$)",
        "(^|[\\s;&|(])python[0-9.]*\\s+-m\\s+django\\s+test(\\s|$)"
      ]
    }
  },
  "model": "claude-sonnet-5-5",
  "preregistration": {
    "control_requirements": {
      "gold": "harness verdict resolved; every FAIL_TO_PASS passes; every PASS_TO_PASS is maintained; patch applied; 0 errors, 0 infrastructure failures",
      "noop": "harness verdict unresolved; 0 of the FAIL_TO_PASS tests pass; patch applied; 0 errors, 0 infrastructure failures",
      "noop_patch": "adds one new text file (AIEP_NOOP_CONTROL.txt): applies to any repository and changes no behaviour"
    },
    "replacement_rules": [
      "a task is replaced ONLY if it fails its gold or no-op control (or its image cannot be pinned) BEFORE any agent run on it; a task is never replaced because of an agent outcome",
      "the replacement is the first task in the replacement order that is unused and keeps at most 2 tasks per repository and at least 4 repositories",
      "the replacement takes the failed task's block position AND its arm order (so the 4/4 balance of first arms is kept); it is recorded in the batch state, never by editing this file",
      "if no replacement is allowed the batch stops for review (control_replacement_exhausted)"
    ],
