      "action": "halt",
      "id": "disk_start_gate",
      "rule": "a block does not start below the 16 GiB start gate (the gate is never lowered for the experiment)"
    },
    {
      "action": "halt",
      "id": "grading_invalid",
      "rule": "a grading run that is not valid (harness error, infrastructure failure, hard stop, incomplete report) halts the batch for diagnosis; it is never read as a model failure"
    },
    {
      "action": "halt",
      "id": "task_not_prepared",
      "rule": "a block cannot start until its image, seed and identity are pinned and the controls ran (each needs its own approval)"
    },
    {
      "action": "halt",
      "id": "cumulative_cost_cap",
      "rule": "cumulative gateway-computed cost plus the estimated exposure of the next run would exceed max_total_computed_usd"
    },
    {
      "action": "halt",
      "id": "hidden_data_leak",
      "rule": "the handoff scan finds hidden test ids or patch lines in an agent's input"
    },
    {
      "action": "halt",
      "id": "control_replacement_exhausted",
      "rule": "a task failed its controls and no pre-registered replacement is allowed"
    },
    {
      "action": "halt",
      "id": "consecutive_invalid_runs",
      "n": 2,
      "rule": "2 consecutive runs are rejected for infrastructure reasons (proxy died, lease lost, attachment failure)"
    },
    {
      "action": "halt",
      "id": "orchestrator_error",
      "rule": "any unexpected exception in the batch: halt; resume only after review"
    }
  ]
}
